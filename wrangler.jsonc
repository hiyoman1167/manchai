{
  "name": "learn",
  "main": "worker/index.mjs",
  "account_id": "5796353816f6874627816a829712b1d2",
  "compatibility_date": "2026-10-03",
  // Free plan verified in the account dashboard on 2026-10-04.
  // Disable CHAT_AI_ENABLED before upgrading this account to a Paid plan.
  "vars": {"CHAT_AI_ENABLED": "true"},
  "ai": {"binding": "AI"},
  "ratelimits": [{"name": "CHAT_RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 6, "period": 60}}],
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
